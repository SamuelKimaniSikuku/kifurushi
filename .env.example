# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in YOUR values.
# NEVER commit real keys to git — especially SUPABASE_SERVICE_ROLE_KEY
# and STRIPE_SECRET_KEY (they give full admin access).
# ─────────────────────────────────────────────────────────────

# Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_or_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price ID for Premium:
# Products → Add product → "Kifurushi Premium" → Price: KES 150, Recurring, Weekly
STRIPE_PREMIUM_PRICE_ID=price_xxx

# App URL (your live domain in production)
NEXT_PUBLIC_APP_URL=https://kifurushiapp.com
